# =============================================================================
# Self-Improving Browser Automation Agent — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# =============================================================================

# --- LLM API (Groq) ---
# All keys rotated in round-robin — hot-swap on 429, no wasted sleep time
# Add as many keys as you have (comma-separated, no spaces)
GROQ_API_KEYS=gsk_YOUR_KEY_1_HERE,gsk_YOUR_KEY_2_HERE,gsk_YOUR_KEY_3_HERE,gsk_YOUR_KEY_4_HERE
# Fallback if GROQ_API_KEYS is not set
GROQ_API_KEY=gsk_YOUR_KEY_1_HERE

# Model for planning, reflection and verification
GROQ_PLANNING_MODEL=openai/gpt-oss-120b

# Model for tool-calling steps (routine steps use GROQ_FAST_ACTION_MODEL when it is offered)
GROQ_ACTION_MODEL=openai/gpt-oss-120b

# --- Browser / Playwright ---
# Chrome DevTools Protocol endpoint
CDP_ENDPOINT=http://localhost:9222
# The agent's Chrome always uses its own profile (~/.self_improving_agent/chrome_profile),
# never one of yours, so there is no Chrome profile setting.

# --- Email (read, draft and send mail from your own mailbox) ---
# setup_email.bat fills these in and checks the sign-in. Gmail needs an App Password
# (Google Account > Security > 2-Step Verification > App passwords), not your Google password.
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
# Optional: the name people see next to your address
EMAIL_DISPLAY_NAME=
# Only for a provider other than Gmail, Yahoo, iCloud, Zoho or Outlook (and not a Google/Microsoft college domain)
EMAIL_IMAP_HOST=
EMAIL_SMTP_HOST=

# --- WebSocket (Extension <-> Backend) ---
WS_HOST=localhost
WS_PORT=8765

# --- FastAPI ---
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# --- Database ---
# SQLite. A relative path is inside the backend folder (backend/data/agent.db).
DB_URL=sqlite+aiosqlite:///./data/agent.db

# --- Agent Behavior ---
# Maximum retries per step before failing
MAX_STEP_RETRIES=3

# Delay range between actions (seconds) — anti-bot measure
ACTION_DELAY_MIN=1.0
ACTION_DELAY_MAX=3.0

# Maximum steps per task before aborting
MAX_TASK_STEPS=30

# --- Wake Word Listener (Hands-Free Voice Activation) ---
# Set to true to enable always-on microphone listener on backend startup
WAKE_WORD_ENABLED=true
# The word that activates recording (say this to start a command)
WAKE_WORD=emma
# The word that stops recording (say this to end a command)
WAKE_WORD_STOP=done
# Max seconds to listen for an instruction after wake word detection
WAKE_WORD_LISTEN_TIMEOUT=30

# --- Logging ---
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Level 3 learning (semantic memory + LLM reflection + feedback)
# ---------------------------------------------------------------------------
SEMANTIC_MEMORY_ENABLED=true
CHROMA_PATH=./data/chroma
SEMANTIC_RECALL_K=5
SEMANTIC_MIN_SIMILARITY=0.35
SEMANTIC_LESSON_MIN_SIMILARITY=0.3
LLM_REFLECTION_ENABLED=true
AUTO_RETRY_ON_FAILURE=true

# ---------------------------------------------------------------------------
# Model routing
# ---------------------------------------------------------------------------
# groq (default) or openai (then set OPENAI_API_KEY; OPENAI_MODEL defaults to gpt-4o-mini)
LLM_PROVIDER=groq
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
TWO_TIER_ACTOR=true
PREFER_LLAMA_MODELS=true

# Free Gemini: tried in order when every Groq key is rate-limited or Groq is down; also the vision models
GEMINI_API_KEY=
LLM_FALLBACK_MODEL=gemini/gemini-3.6-flash,gemini/gemini-2.5-flash-lite
GEMINI_VISION_MODEL=gemini/gemini-3.6-flash,gemini/gemini-2.5-flash-lite
GROQ_MAX_COOLDOWN_WAIT_SECONDS=3
# auto | gemini | groq
VISION_PROVIDER=auto
VISION_VERIFICATION_ENABLED=true

# ---------------------------------------------------------------------------
# Wake word: vosk (offline, default; falls back to google if the model is missing) or google (online)
# ---------------------------------------------------------------------------
WAKE_WORD_ENGINE=vosk
VOSK_MODEL_PATH=./data/vosk-model-small-en-us-0.15

# ---------------------------------------------------------------------------
# Emma's voice (text to speech)
# ---------------------------------------------------------------------------
# Three voices, tried in this order. One that fails or is rate limited sits out
# briefly and the next answers, so she is never silent.
#   groq    canopylabs/orpheus-v1-english - natural; accept its terms once at
#           https://console.groq.com/playground?model=canopylabs%2Forpheus-v1-english
#   gemini  gemini-3.1-flash-tts-preview  - high quality, same free key as vision
#   windows Zira / Hazel / David          - robotic, offline, unlimited
TTS_ENABLED=true
TTS_ORDER=groq,gemini,windows
TTS_GROQ_MODEL=canopylabs/orpheus-v1-english
# autumn, diana, hannah, austin, daniel or troy
TTS_GROQ_VOICE=autumn
TTS_GEMINI_MODEL=gemini-3.1-flash-tts-preview
TTS_GEMINI_VOICE=Kore
# Also the ONLY voice used for private text (one-time codes, passwords, mail)
TTS_WINDOWS_VOICE=Microsoft Zira Desktop
TTS_WINDOWS_RATE=1
TTS_MAX_CHARS=600
TTS_CACHE_ENABLED=true

# ---------------------------------------------------------------------------
# Hearing you correctly
# ---------------------------------------------------------------------------
# Names Emma should expect to hear - your contacts, shops, anything she gets
# wrong. Comma separated. They are given to Whisper before it transcribes and
# used to repair near misses ("Mentra" -> "Myntra").
SPEECH_EXTRA_NAMES=

# The most text one request may carry, in characters across every message.
# Groq refuses a request above its per-minute token limit.
LLM_REQUEST_CHAR_BUDGET=14000
